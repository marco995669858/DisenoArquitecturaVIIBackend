JWT_SECRET=rK4qA6y+X8uN5J0yB6x2aV3pM9nL8qA7vB1xC2zD3eF4=
# Access token corto a proposito (15 min): es un JWT sin estado, nadie puede
# revocarlo antes de que expire si se filtra. El refresh token (8h, ver
# ImplUsuario.REFRESH_TOKEN_EXPIRATION_MS) si se puede invalidar porque vive
# en la tabla refresh_token -- el interceptor del frontend renueva el access
# token solo ante un 401/403, asi que esto es transparente para el usuario.
TOKEN_EXPIRATION=900000